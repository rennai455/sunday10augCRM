# Railway production environment template
# Copy these into Railway → Variables (do not commit a real .env with secrets).

NODE_ENV=production
PORT=3002

# Database (copy from Railway Postgres → Connect)
# Ensure the URL ends with ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
PG_SSL=true

# Secrets (generate strong random values; do not commit them)
# Example generation: `openssl rand -hex 32`
JWT_SECRET=<REPLACE_WITH_RANDOM_32B_HEX>
WEBHOOK_SECRET=<REPLACE_WITH_RANDOM_32B_HEX>
ADMIN_API_TOKEN=<OPTIONAL_STRONG_TOKEN>

# Admin bootstrap
SEED_ADMIN_EMAIL=admin@renn.ai
SEED_ADMIN_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>

# CORS allowlist (comma-separated)
ALLOWED_ORIGINS=https://<your-service>.up.railway.app,https://<your-domain>

# Optional integrations
# REDIS_URL=redis://default:password@host:6379
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=renn-ai-crm

# Metrics (internal-only in production)
METRICS_INTERNAL_ONLY=true
METRICS_ALLOWED_HOST_SUFFIX=railway.internal
# METRICS_TOKEN=<OPTIONAL_FOR_NON-PROD_ONLY>

# Rate limiting / proxy
RATE_LIMIT_TRUST_PROXY=true

# 2FA
TWO_FA_REQUIRED_FOR_ADMIN=true
TOTP_ENCRYPTION_KEY=<64_HEX_CHARS>
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Optional tuning
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_MS=30000
# API_RATE_WINDOW_MS=900000
# API_RATE_MAX=1000
# AUTH_RATE_WINDOW_MS=900000
# AUTH_RATE_MAX=10
