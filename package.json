{
  "name": "renn-ai-crm",
  "version": "1.0.0",
  "description": "A modern CRM dashboard with secure authentication, live API metrics, and modular front-end.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "build": "echo 'no build step required'",
    "db:migrate": "node db/run-migrations.js",
    "db:seed": "node db/seed.js",
    "db:prepare": "npm run db:migrate && npm run db:seed",
    "db:backfill:totp": "node scripts/backfill-totp-encryption.js"
  },
  "author": "rennai455",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@sentry/node": "^8.28.0",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cssnano": "^7.1.0",
    "csurf": "^1.11.0",
    "dotenv": "^17.2.1",
    "envalid": "^8.0.0",
    "esbuild": "^0.21.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-slow-down": "^2.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "npm-run-all": "^4.1.5",
    "pg": "^8.16.3",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "otplib": "^12.0.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "prom-client": "^15.1.2",
    "rate-limit-redis": "^4.2.2",
    "redis": "^4.6.13",
    "tailwindcss": "^4.1.11",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.37.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
